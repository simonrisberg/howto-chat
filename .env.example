# Local models via Ollama (no API key needed)
OLLAMA_HOST=http://127.0.0.1:11434
# Embeddings (Swedish + English). Changing it requires `npm run ingest`.
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_MODEL=qwen3.5:4b
# Let qwen "think" before answering: slower, sometimes more careful
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192

# Folder with the HOWTO documents (markdown / pdf / txt, any nesting). Relative to the repo root.
HOWTO_DIR=./howto

# Where the local LanceDB vector database is stored
VECTOR_DB_DIR=./data/lancedb
